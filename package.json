{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.ts",
  "scripts": {
    "test": "vitest run",
    "check:fast": "node node_modules/typescript/bin/tsc --noEmit",
    "check:build-install": "node scripts/check-build-install.mjs",
    "check:startup": "node scripts/check-startup.mjs",
    "check:tenants": "node --experimental-strip-types scripts/check-tenant-scoping.ts",
    "audit:release": "node scripts/repo_auditor.js",
    "seed": "node --env-file=.env --experimental-strip-types scripts/seedDatabase.ts",
    "seed:clean": "node --env-file=.env --experimental-strip-types scripts/seedFreshCleanDB.ts",
    "setup:root-2fa": "node --env-file=.env --experimental-strip-types scripts/setupRoot2FA.ts",
    "setup:root-2fa:production": "node --experimental-strip-types scripts/setupRoot2FA.ts",
    "check:root-2fa:production": "node --experimental-strip-types scripts/checkRoot2FA.ts",
    "generate:keys": "node --experimental-strip-types scripts/generateKeys.ts",
    "backup:mongo": "node --env-file=.env --experimental-strip-types scripts/mongoBackup.ts",
    "restore:mongo:drill": "node --env-file=.env --experimental-strip-types scripts/mongoRestoreDrill.ts",
    "migrate:tenant": "node --env-file=.env --experimental-strip-types scripts/migrateTenantScoping.ts",
    "migrate:active-consultation-lock": "node --env-file=.env --experimental-strip-types scripts/migrate-active-consultation-lock.ts",
    "migrate:outbox-indexes": "node --env-file=.env --experimental-strip-types scripts/migrate-outbox-indexes.ts",
    "migrate:whatsapp": "node --env-file=.env --experimental-strip-types scripts/migrate-whatsapp-storage.ts",
    "migrate:domain-event-indexes": "node --env-file=.env --experimental-strip-types scripts/migrate-domain-event-indexes.ts",
    "worker:notifications": "node --env-file-if-exists=.env dist/workers/notificationDeliveryWorker.js",
    "worker:disruption-timeouts": "node --env-file-if-exists=.env dist/workers/disruptionTimeoutWorker.js",
    "worker:outbound-messages": "node --env-file-if-exists=.env dist/workers/outboundMessageWorker.js",
    "worker:domain-events": "node --env-file-if-exists=.env dist/workers/domainEventWorker.js",
    "replay:dead-letters": "node --env-file=.env --experimental-strip-types scripts/operator-replay.ts",
    "audit:scan": "node --env-file=.env --experimental-strip-types scripts/audit-remediation.ts",
    "build": "node scripts/build.mjs",
    "start": "node dist/index.js",
    "dev": "node --env-file-if-exists=.env scripts/dev.mjs",
    "worker:no-show": "node --env-file-if-exists=.env dist/workers/noShowSweepWorker.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JrP12345/jk-backend.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "config": {
    "mongodbMemoryServer": {
      "disablePostinstall": true
    }
  },
  "bugs": {
    "url": "https://github.com/JrP12345/jk-backend/issues"
  },
  "homepage": "https://github.com/JrP12345/jk-backend#readme",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "@aws-sdk/s3-request-presigner": "^3.1127.0",
    "@fastify/compress": "^9.2.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/rate-limit": "^11.0.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.0",
    "@fastify/websocket": "^11.3.0",
    "@sentry/node": "^11.4.0",
    "@simplewebauthn/server": "^14.0.3",
    "bcryptjs": "^3.0.3",
    "fastify": "^5.12.3",
    "fastify-plugin": "^6.0.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.9.5",
    "nodemailer": "^10.0.1",
    "qrcode": "^1.5.4",
    "speakeasy": "^2.0.0"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.8",
    "@types/node": "^26.5.0",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/speakeasy": "^2.0.10",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.0",
    "mongodb-memory-server": "^11.2.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
