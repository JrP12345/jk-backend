{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.ts",
  "scripts": {
    "test": "vitest run",
    "check:fast": "node ../scripts/dev_check.js",
    "check:feature": "node ../scripts/feature_check.js",
    "check:tenants": "node --experimental-strip-types scripts/check-tenant-scoping.ts",
    "audit:release": "node ../scripts/repo_auditor.js",
    "audit": "node ../scripts/repo_auditor.js",
    "seed": "node --env-file=.env --experimental-strip-types scripts/seedDatabase.ts",
    "seed:clean": "node --env-file=.env --experimental-strip-types scripts/seedFreshCleanDB.ts",
    "setup:root-2fa": "node --env-file=.env --experimental-strip-types scripts/setupRoot2FA.ts",
    "setup:root-2fa:production": "node --experimental-strip-types scripts/setupRoot2FA.ts",
    "generate:keys": "node --experimental-strip-types scripts/generateKeys.ts",
    "backup:mongo": "node --env-file=.env --experimental-strip-types scripts/mongoBackup.ts",
    "restore:mongo:drill": "node --env-file=.env --experimental-strip-types scripts/mongoRestoreDrill.ts",
    "migrate:tenant": "node --env-file=.env --experimental-strip-types scripts/migrateTenantScoping.ts",
    "migrate:active-consultation-lock": "node --env-file=.env --experimental-strip-types scripts/migrate-active-consultation-lock.ts",
    "migrate:outbox-indexes": "node --env-file=.env --experimental-strip-types scripts/migrate-outbox-indexes.ts",
    "migrate:domain-event-indexes": "node --env-file=.env --experimental-strip-types scripts/migrate-domain-event-indexes.ts",
    "worker:notifications": "node --env-file=.env --experimental-strip-types workers/notificationDeliveryWorker.ts",
    "worker:disruption-timeouts": "node --env-file=.env --experimental-strip-types workers/disruptionTimeoutWorker.ts",
    "worker:outbound-messages": "node --env-file=.env --experimental-strip-types workers/outboundMessageWorker.ts",
    "worker:domain-events": "node --env-file=.env --experimental-strip-types workers/domainEventWorker.ts",
    "replay:dead-letters": "node --env-file=.env --experimental-strip-types scripts/operator-replay.ts",
    "audit:scan": "node --env-file=.env --experimental-strip-types scripts/audit-remediation.ts",
    "build": "esbuild index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/index.js --target=node20",
    "postinstall": "npm run build",
    "prestart": "npm run build",
    "start": "node dist/index.js",
    "start:ts": "node --experimental-strip-types index.ts",
    "dev": "nodemon -e js,ts,json,env --exec \"node --env-file=.env --experimental-strip-types\" index.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JrP12345/jk-backend.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/JrP12345/jk-backend/issues"
  },
  "homepage": "https://github.com/JrP12345/jk-backend#readme",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "@aws-sdk/s3-request-presigner": "^3.1127.0",
    "@fastify/compress": "^9.2.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/rate-limit": "^11.0.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.0",
    "@fastify/websocket": "^11.3.0",
    "@sentry/node": "^10.73.0",
    "@simplewebauthn/server": "^14.0.3",
    "bcryptjs": "^3.0.3",
    "esbuild": "^0.28.0",
    "fastify": "^5.12.3",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.9.5",
    "nodemailer": "^10.0.1",
    "qrcode": "^1.5.4",
    "speakeasy": "^2.0.0"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.8",
    "@types/node": "^26.5.0",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/speakeasy": "^2.0.10",
    "@types/ws": "^8.18.1",
    "mongodb-memory-server": "^11.2.0",
    "typescript": "5.9.3",
    "vitest": "^5.0.0"
  }
}
