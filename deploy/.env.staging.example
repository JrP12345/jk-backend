# Copy to .env.staging on the authorized staging host; chmod 600.
# No secrets belong in Git. Blank required values intentionally prevent startup.
NODE_ENV=production
APP_URL=https://dev.ekavyu.com
FRONTEND_URL=https://dev.ekavyu.com
# Backend adds /api itself to webhook URLs; keep this value an origin.
PUBLIC_API_BASE_URL=https://dev.ekavyu.com
CORS_ALLOWED_ORIGINS=https://dev.ekavyu.com
NEXT_PUBLIC_API_URL=https://dev.ekavyu.com/api
CADDY_SITE_ADDRESS=dev.ekavyu.com
ACME_EMAIL=
WEBAUTHN_ORIGIN=https://dev.ekavyu.com
WEBAUTHN_RP_ID=dev.ekavyu.com
# Same-origin cookies scoped to dev.ekavyu.com (never .ekavyu.com).
COOKIE_DOMAIN=
COOKIE_SAME_SITE=lax
# Authenticated replica set/Atlas URI, explicit database ekavyu_dev.
# mongodb+srv://USER:URL_ENCODED_PASSWORD@CLUSTER/ekavyu_dev?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_MIN_POOL_SIZE=1
MONGODB_MAX_POOL_SIZE=10
# Generate an independent random hex password; Compose supplies the Redis URL.
REDIS_PASSWORD=
DATA_ENCRYPTION_KEY=
PRESCRIPTION_SIGNING_KEY=
JWT_PRIVATE_KEY_BASE64=
JWT_PUBLIC_KEY_BASE64=
# Unique local release tags, e.g. ekavyu-backend:staging-BACKEND_SHA.
STAGING_BACKEND_IMAGE=
STAGING_FRONTEND_IMAGE=
# A test webhook secret is required even for reception-payment-only smoke.
UPI_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Separate PRIVATE staging bucket; required to test branding/document uploads.
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# No public R2 domain: private documents use signed URLs.
# Configure a test inbox/provider before checking email/OTP delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Ekavyu Staging
LOG_LEVEL=info
# Optional until their flows are tested; no production integration credentials.
GEMINI_API_KEY=
META_WHATSAPP_WABA_ID=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_APP_SECRET=
META_WHATSAPP_VERIFY_TOKEN=
