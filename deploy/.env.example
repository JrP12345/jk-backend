# Production Compose configuration. Copy to .env; supply real secret values outside Git.
NODE_ENV=production
BACKEND_IMAGE=
FRONTEND_IMAGE=
# Authenticated MongoDB replica set / managed database, not a standalone local server.
MONGODB_URI=
REDIS_URL=
APP_URL=https://app.example.com
FRONTEND_URL=https://app.example.com
PUBLIC_API_BASE_URL=https://api.example.com
CORS_ALLOWED_ORIGINS=https://app.example.com
ENCRYPTION_KEY=
JWT_PRIVATE_KEY_BASE64=
JWT_PUBLIC_KEY_BASE64=
UPI_WEBHOOK_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Passed as a frontend image BUILD argument; a runtime variable does not rebuild the browser.
NEXT_PUBLIC_API_URL=https://api.example.com/api
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Ekavyu
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
BACKEND_PORT=5000
FRONTEND_PORT=3000
