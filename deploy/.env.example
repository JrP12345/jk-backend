# ==============================================================================
# Ekavyu Healthcare Platform — Development Deployment Environment Configuration
# Target Domain: https://dev.ekavyu.com
# ==============================================================================

# Node Environment & Port Configuration
# Persistent prescription integrity key required for this production-mode dev stack.
PRESCRIPTION_SIGNING_KEY=
NODE_ENV=production
PORT=5000

# Public URLs & Origins (Strictly dev.ekavyu.com)
APP_URL=https://dev.ekavyu.com
FRONTEND_URL=https://dev.ekavyu.com
PUBLIC_API_BASE_URL=https://dev.ekavyu.com
CORS_ALLOWED_ORIGINS=https://dev.ekavyu.com

# Build-Time Frontend Public API URL (baked into Next.js bundle at docker build)
NEXT_PUBLIC_API_URL=https://dev.ekavyu.com/api

# Caddy Automatic HTTPS Configuration
CADDY_SITE_ADDRESS=dev.ekavyu.com
ACME_EMAIL=devops@ekavyu.com

# ------------------------------------------------------------------------------
# MongoDB Configuration (Dedicated Development Replica Set)
# MUST be a replica set (mongodb+srv:// or with ?replicaSet=) to support ACID transactions.
# Development pool sizing overrides:
# ------------------------------------------------------------------------------
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<dev-cluster>.mongodb.net/ekavyu_dev?retryWrites=true&w=majority
MONGODB_MIN_POOL_SIZE=2
MONGODB_MAX_POOL_SIZE=10

# ------------------------------------------------------------------------------
# Redis In-Memory Cache & Distributed Lock Service
# ------------------------------------------------------------------------------
# Generate with: openssl rand -hex 24
REDIS_PASSWORD=change_this_to_a_secure_random_development_password
# Internal Docker connection URL used by backend and workers:
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379

# ------------------------------------------------------------------------------
# Security, Encryption & Cryptographic Keys
# ------------------------------------------------------------------------------
# Persistent field-encryption secret shared by the API and workers.
# Reuse the exact existing value when updating an installation with encrypted records.
# Generate only for a fresh database: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DATA_ENCRYPTION_KEY=replace_with_64_character_hex_encryption_key

# RS256 JWT Keypair (Base64-encoded PEM strings)
# Generate with:
#   cd backend && npm run generate:keys OR:
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
#   base64 -w 0 private.pem > private_base64.txt
#   base64 -w 0 public.pem > public_base64.txt
JWT_PRIVATE_KEY_BASE64=replace_with_base64_encoded_rs256_private_key
JWT_PUBLIC_KEY_BASE64=replace_with_base64_encoded_rs256_public_key

# WebAuthn / Passkeys (Must match exact domain)
WEBAUTHN_ORIGIN=https://dev.ekavyu.com
WEBAUTHN_RP_ID=dev.ekavyu.com

# ------------------------------------------------------------------------------
# Background Workers & Schedulers
# ------------------------------------------------------------------------------
# Dedicated workers handle scheduled jobs; disable duplicate inline execution in API
RUN_INLINE_JOBS=false
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# Payment Gateways (Test / Sandbox Credentials for Development)
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_replace_with_dev_key_id
RAZORPAY_KEY_SECRET=replace_with_dev_key_secret
RAZORPAY_WEBHOOK_SECRET=replace_with_dev_webhook_secret
UPI_WEBHOOK_SECRET=replace_with_dev_upi_webhook_secret

# ------------------------------------------------------------------------------
# Cloudflare R2 Document & Image Storage (Development Bucket)
# ------------------------------------------------------------------------------
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=ekavyu-dev-vault
R2_CUSTOM_DOMAIN=

# ------------------------------------------------------------------------------
# AI Provider (Clinical AI Modules)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# Outbound Email (SMTP)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=apikey
SMTP_PASS=
SMTP_FROM_EMAIL=no-reply@dev.ekavyu.com
SMTP_FROM_NAME=Ekavyu Healthcare (Dev)

# ------------------------------------------------------------------------------
# WhatsApp Cloud API (Development Sandbox or Test Account)
# ------------------------------------------------------------------------------
META_WHATSAPP_WABA_ID=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_APP_SECRET=
META_WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v25.0
WHATSAPP_SANDBOX_MODE=true
