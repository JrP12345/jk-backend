# Ekavyu Healthcare Backend Environment Variables
# Production requires a persistent prescription key (at least 32 characters).
# Preserve the persistent signing secret for existing seals.
PRESCRIPTION_SIGNING_KEY=
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/ekavyu_dev

# CORS Configuration (Comma-separated origins, defaults to http://localhost:3000)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Redis: optional in development, required in production unless explicitly single-instance.
# This localhost URL is development-only; use the Redis service URL in Render.
REDIS_URL=redis://localhost:6379
# For ONE production API instance without Redis, remove REDIS_URL/REDIS_HOST and set:
# ALLOW_SINGLE_NODE_IN_PRODUCTION=true
# Do not enable this override for multiple API replicas.

# Service RS256 Keypair (Optional - auto-generated in keys/ directory if omitted)
# JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n..."
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n..."

# Cloudflare R2 Storage (required only when document/image upload is enabled)
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET_NAME=your_bucket_name
R2_CUSTOM_DOMAIN=https://your-public-r2-domain.example

# Field-Level Encryption (Required for secure credential storage in MongoDB)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DATA_ENCRYPTION_KEY=your_64_char_hex_encryption_key

# Outbound email (required for real delivery; otherwise production requests fail closed)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME=Ekavyu

# External clinical integrations (required by the corresponding production module)
PACS_BASE_URL=https://pacs.example.com
TELECONSULTATION_BASE_URL=https://teleconsult.example.com
# Self-hosted Orthanc DICOMweb. Credentials remain on the backend.
PACS_DICOMWEB_BASE_URL=
PACS_DICOMWEB_USERNAME=
PACS_DICOMWEB_PASSWORD=
# Optional bearer token instead of username/password.
PACS_DICOMWEB_TOKEN=

# AI provider: configure one provider for clinical AI routes
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# Razorpay payment integration
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Deep synthetic health probes mutate a dedicated canary collection and are
# intentionally separate from public liveness/readiness probes.
SYNTHETIC_HEALTH_SECRET=

# Passkeys: exact public frontend origin and its hostname (HTTPS required outside localhost)
WEBAUTHN_ORIGIN=http://localhost:3000
WEBAUTHN_RP_ID=localhost

# WhatsApp Cloud API. Prefer saving shared credentials through root WhatsApp settings.
# Missing credentials never simulate live delivery; sandbox is for development only.
PUBLIC_API_BASE_URL=http://localhost:5000
WHATSAPP_API_VERSION=v25.0
WHATSAPP_SANDBOX_MODE=false
META_WHATSAPP_WABA_ID=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_APP_SECRET=
META_WHATSAPP_VERIFY_TOKEN=
META_WHATSAPP_LANG=en
# Production: run npm run worker:outbound-messages for sending AND webhook processing.
# Development runs both workers inline. Enable inline workers in production only deliberately.
RUN_INLINE_JOBS=false

APP_URL=http://localhost:3000
# Optional configured model overrides; monthlyTokenQuota is currently an advisory setting.
GEMINI_MODEL=
GEMINI_REASONING_MODEL=
OPENAI_MODEL=

# Explicit development root provisioning (empty local databases only)
ROOT_ADMIN_EMAIL=
ROOT_ADMIN_PASSWORD=
# Required for the optional encrypted backup workflow
BACKUP_ENCRYPTION_KEY=
