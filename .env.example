# ANANTA Healthcare Backend Environment Variables
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/jk_healthcare

# CORS Configuration (Comma-separated origins, defaults to http://localhost:3000)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Centralized Redis Store (Optional - defaults to in-memory store if unset)
REDIS_URL=redis://localhost:6379

# Service RS256 Keypair (Optional - auto-generated in keys/ directory if omitted)
# JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n..."
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n..."

# Cloudflare R2 Storage (required only when document/image upload is enabled)
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET_NAME=your_bucket_name
R2_CUSTOM_DOMAIN=https://your-public-r2-domain.example

# Field-Level Encryption (Required for secure credential storage in MongoDB)
# Generate with: node -e "require('crypto').randomBytes(32).toString('hex') |> console.log"
ENCRYPTION_KEY=your_64_char_hex_encryption_key

# Outbound email (required for real delivery; otherwise production requests fail closed)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME=Ananta Health

# External clinical integrations (required by the corresponding production module)
PACS_BASE_URL=https://pacs.example.com
TELECONSULTATION_BASE_URL=https://teleconsult.example.com

# AI provider: configure one provider for clinical AI routes
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# Razorpay payment integration
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Deep synthetic health probes mutate a dedicated canary collection and are
# intentionally separate from public liveness/readiness probes.
SYNTHETIC_HEALTH_SECRET=

# Tracker capability enforcement is always on in production. Set this to true
# in staging/development before migrating legacy tracker links.
ENFORCE_TRACKER_CAPABILITIES=false

# Passkeys: exact public frontend origin and its hostname (HTTPS required outside localhost)
WEBAUTHN_ORIGIN=http://localhost:3000
WEBAUTHN_RP_ID=localhost
